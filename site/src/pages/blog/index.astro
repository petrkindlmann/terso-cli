---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('blog');
const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const showDrafts = import.meta.env.PUBLIC_SHOW_DRAFTS === '1' || import.meta.env.DEV;
const posts = showDrafts ? sorted : sorted.filter(p => p.data.status === 'published');
---
<BaseLayout title="blog — terso" ogPath="/blog/">
  <main>
    <p class="tagline">posts about terso, AGENTS.md, and the AI-coding-agent ecosystem</p>
    <h1>Blog</h1>
    {!showDrafts && posts.length === 0 && (
      <p style="color: var(--fg-muted);">
        Posts go live at launch. Drafts visible in dev mode via <code>PUBLIC_SHOW_DRAFTS=1</code>.
      </p>
    )}
    <ul class="post-list">
      {posts.map(post => (
        <li>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          </time>
          {post.data.status === 'draft' && <span class="draft" style="font-size:11px"> DRAFT</span>}
          <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          {post.data.tags.length > 0 && (
            <p class="tags">{post.data.tags.join(' · ')}</p>
          )}
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
