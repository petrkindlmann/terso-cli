---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<BaseLayout title="terso — one AGENTS.md, every agent">
  <main>
    <p class="tagline">one source of truth for AI agent rules, in every project</p>
    <h1>You maintain the same project rules in four files. Stop.</h1>
    <p>
      <code>terso emit</code> compiles a single <code>AGENTS.md</code> at your
      repo root into every per-agent config file your toolchain expects —
      <code>CLAUDE.md</code>, <code>.cursorrules</code>,
      <code>.github/copilot-instructions.md</code> — and gates drift in CI.
      Offline. Free. MIT.
    </p>

    <h2>Install</h2>
    <pre><code>npm install -g terso-cli
cd your-project
terso init       # scaffolds AGENTS.md
terso emit       # writes CLAUDE.md, .cursorrules, etc.</code></pre>

    <h2>CI gate (1 line)</h2>
    <pre><code>- run: npx terso-cli@1 emit --check</code></pre>
    <p style="color: var(--fg-muted); font-size: 14px;">
      Exit codes: <code>0</code> clean · <code>1</code> drift · <code>2</code> error.
    </p>

    <h2>Reading</h2>
    {posts.length > 0 ? (
      <ul class="post-list">
        {posts.map(post => (
          <li>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          </li>
        ))}
      </ul>
    ) : (
      <p style="color: var(--fg-muted);">
        Posts land at launch.
        <a href="/blog">See drafts →</a>
      </p>
    )}

    <h2>Want hosted knowledge?</h2>
    <p>
      <code>terso emit</code> is free forever. If your team wants searchable
      knowledge memory across projects, <a href="https://omnus.dev?source=terso-cli">sign up for Omnus</a>.
    </p>
  </main>
</BaseLayout>
